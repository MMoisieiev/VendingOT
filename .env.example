# Local development only. Copy to .env before starting Docker Compose.
POSTGRES_USER=vendingot
POSTGRES_PASSWORD=vendingot
POSTGRES_DB=vendingot
# The API defaults to this local database URL; override via the process environment.
DATABASE_URL=postgresql://vendingot:vendingot@127.0.0.1:5432/vendingot
# API binds to loopback. There is no production authentication in this milestone.
API_HOST=127.0.0.1
API_PORT=3001
